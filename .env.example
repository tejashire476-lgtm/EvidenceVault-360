# ============================================================================
# EvidenceVault 360 — Environment Configuration Specification
# Zero Egress Object Storage & Cryptographic Verification Settings
# ============================================================================

# Storage Provider: "CLOUDFLARE_R2" (Production) or "LOCAL_OBJECT_STORE" (Development / Demo)
VITE_STORAGE_PROVIDER="CLOUDFLARE_R2"

# Cloudflare R2 Object Storage Credentials (Optional for local offline demo)
# Keep strictly in server environment; never commit production credentials
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="evidencevault-360-artifacts-r2"
R2_PUBLIC_DOMAIN="" # Kept empty: Bucket remains strictly private

# Governance & Quotas
STORAGE_MAX_FILE_SIZE_BYTES=107374182400 # 100 GB default limit per disk image
STORAGE_PRESIGNED_UPLOAD_TTL_SECONDS=900 # 15 minutes expiration for presigned upload URLs
STORAGE_PRESIGNED_DOWNLOAD_TTL_SECONDS=300 # 5 minutes expiration for ephemeral download URLs

# ============================================================================
# Phase 6: Application Security, RBAC & Rate Limiting
# ============================================================================
VITE_JWT_SECRET="synth-hmac-jwt-secret-key-min-32-chars-for-dev"
VITE_SESSION_TTL_MINUTES=60 # 1 hour session lifetime
VITE_RATE_LIMIT_WINDOW_MS=60000 # 1 minute window
VITE_RATE_LIMIT_MAX_AUTH_ATTEMPTS=5 # Maximum 5 failed logins before lockout
VITE_RATE_LIMIT_MAX_DOWNLOADS=10 # Maximum 10 evidence downloads per minute
VITE_ENFORCE_STRICT_RBAC=true # Enforce backend-level authorization guards
VITE_ENFORCE_IDOR_PROTECTION=true # Prevent accessing evidence from unassigned cases

# ============================================================================
# Phase 7: Offline Mode & Safe Data Synchronization
# ============================================================================
VITE_OFFLINE_SYNC_MAX_RETRIES=3
VITE_OFFLINE_STORAGE_KEY_PREFIX="ev360_offline_queue_"
VITE_OFFLINE_CACHE_RESTRICTION="METADATA_ONLY" # Raw file blobs and reports strictly excluded from offline cache

# ============================================================================
# Phase 8: Offline Biometric Face Verification (Conditional MFA)
# ============================================================================
VITE_BIOMETRIC_MFA_ENABLED=true
VITE_BIOMETRIC_COSINE_SIMILARITY_THRESHOLD=0.85
VITE_BIOMETRIC_LIVENESS_CHALLENGE_TIMEOUT_MS=15000
VITE_BIOMETRIC_RAW_IMAGE_RETENTION="NONE" # Zero retention of biometric images; vectors and SHA-256 digests only

# ============================================================================
# Phase 9: Weekly Audit Review & Legal Compliance
# ============================================================================
VITE_AUDIT_HANDOFF_SLA_HOURS=48 # Flag unacknowledged transfers exceeding 48 hours
VITE_AUDIT_REVIEW_DEFAULT_DAYS=7 # Default observation window for weekly audit reviews
VITE_SECTION_65B_CERTIFICATE_ENABLED=true # Generate Indian Evidence Act / BNSS 65B compliance schedules

# ============================================================================
# Phase 10: Enterprise Backup & Disaster Recovery
# ============================================================================
VITE_BACKUP_EXPORT_ENCRYPTION="AES_GCM_256"
VITE_BACKUP_COMPRESSION="GZIP"

